  "transport_fixture": "import {writeFileSync} from 'node:fs';\nlet sends = 0, sockets = 0;\nglobalThis.WebSocket = class extends EventTarget {\n  static OPEN = 1;\n  readyState = 0;\n  constructor() {\n    super(); sockets++;\n    queueMicrotask(() => { this.readyState = 1; this.dispatchEvent(new Event('open')); });\n  }\n  send(body) {\n    if (JSON.parse(body).type !== 'response.create') throw Error('Unexpected fixture request');\n    if (sends >= 4) throw Error('Fixture request ceiling');\n    sends++;\n    writeFileSync('/workspace/transport-count.json', JSON.stringify({sends, sockets,\n      budget_instruction_present: JSON.stringify(JSON.parse(body)).includes('You have a hard budget of 1 model turns.'),\n      skill_location_present: JSON.stringify(JSON.parse(body)).includes('/home/worker/.pi/agent/skills/example/SKILL.md')}));\n    const id = 'fixture-' + sends;\n    const item = {id, type:'message', role:'assistant', status:'completed',\n      content:[{type:'output_text', text:'READY.', annotations:[]}]};\n    const events = [\n      {type:'response.created', response:{id, status:'in_progress', output:[]}},\n      {type:'response.output_item.added', output_index:0,\n       item:{...item, status:'in_progress', content:[]}},\n      {type:'response.content_part.added', output_index:0, content_index:0, item_id:id,\n       part:{type:'output_text', text:'', annotations:[]}},\n      {type:'response.output_text.delta', output_index:0, content_index:0, item_id:id, delta:'READY.'},\n      {type:'response.output_text.done', output_index:0, content_index:0, item_id:id, text:'READY.'},\n      {type:'response.output_item.done', output_index:0, item},\n      {type:'response.completed', response:{id, status:'completed', output:[item],\n       usage:{input_tokens:1, output_tokens:1}}},\n    ];\n    queueMicrotask(() => { for (const event of events) this.dispatchEvent(\n      new MessageEvent('message', {data: JSON.stringify(event)})); });\n  }\n  close() { this.readyState = 3; }\n};\nconst fixtureSocket = globalThis.WebSocket;\nObject.defineProperty(globalThis, 'WebSocket', {configurable:true,\n  get:() => fixtureSocket, set:() => {}});\n",
  "name_probe": "NODE_OPTIONS='' NODE_DISABLE_COMPILE_CACHE=1 node --input-type=module - >/tmp/parsed-name.json <<'JS'\nimport { parseFrontmatter } from '/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/dist/utils/frontmatter.js';\ntry {\n  const { frontmatter } = parseFrontmatter(process.env.EVAL_SKILL_HEADER);\n  const name = typeof frontmatter.name === 'string' && frontmatter.name\n    ? frontmatter.name : process.env.EVAL_SKILL_FALLBACK;\n  process.stdout.write(JSON.stringify(name));\n} catch {\n  console.error('EVAL_SKILL_HEADER_INVALID');\n  process.exitCode = 2;\n}\nJS",
