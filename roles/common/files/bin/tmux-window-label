#!/usr/bin/env bash
set -euo pipefail

pane_id="${1:-${TMUX_PANE:-}}"
[ -n "$pane_id" ] || exit 0
field_separator='__NMB_TMUX_FIELD__'
parse_separator=$'\x1f'
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
task_label_helper="${TMUX_TASK_LABEL_BIN:-$script_dir/tmux-task-label}"
[ -x "$task_label_helper" ] || task_label_helper="${HOME:-}/.local/bin/tmux-task-label"
glyphs_helper="${TMUX_INDICATOR_GLYPHS_BIN:-$script_dir/tmux-indicator-glyphs}"
[ -x "$glyphs_helper" ] || glyphs_helper="${HOME:-}/.local/bin/tmux-indicator-glyphs"

pane_info="$(tmux display-message -p -t "$pane_id" "#{window_id}${field_separator}#{pane_active}${field_separator}#{window_name}${field_separator}#{pane_tty}${field_separator}#{pane_current_path}${field_separator}#{pane_current_command}${field_separator}#{pane_title}${field_separator}#{pane_id}" 2>/dev/null || true)"
[ -n "$pane_info" ] || exit 0

pane_info="${pane_info//$field_separator/$parse_separator}"
IFS="$parse_separator" read -r window_id pane_active window_name pane_tty pane_current_path pane_current_command pane_title pane_id <<< "$pane_info"
[ -n "$window_id" ] || exit 0
[ "$pane_active" = "1" ] || exit 0
effective_command="${2:-${pane_current_command:-zsh}}"

is_remote_candidate_command() {
  case "$1" in
    ssh|gh|ruby) return 0 ;;
    *) return 1 ;;
  esac
}

agent_kind="$(tmux show-options -qv -p -t "$pane_id" "@agent_kind" 2>/dev/null || true)"
get_process_lines() {
  if [ -n "${TMUX_WINDOW_LABEL_PS_FILE:-}" ] && [ -f "$TMUX_WINDOW_LABEL_PS_FILE" ]; then
    cat "$TMUX_WINDOW_LABEL_PS_FILE"
  elif [ -n "$pane_tty" ]; then
    ps -o pid=,stat=,comm=,args= -t "$pane_tty" 2>/dev/null
  fi
}

node_matches_agent_kind() {
  local line pid stat comm args
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    read -r pid stat comm args <<< "$line"
    case "${stat:-}" in
      *+*) ;;
      *) continue ;;
    esac
    case "$agent_kind:${comm:-}" in
      pi:pi|claude:claude) return 0 ;;
    esac
    [ "${comm:-}" = node ] || continue
    case "$agent_kind" in
      pi)
        printf '%s\n' "${args:-}" | grep -Eq '(^|[^[:alnum:]_-])pi-coding-agent([^[:alnum:]_-]|$)' && return 0
        ;;
      claude)
        printf '%s\n' "${args:-}" | grep -Eq '(^|[[:space:]/])@anthropic-ai/claude-code([[:space:]/]|$)' && return 0
        ;;
    esac
  done < <(get_process_lines)
  return 1
}

live_agent=""
case "$agent_kind:$effective_command" in
  claude:claude|codex:codex|pi:pi) live_agent=1 ;;
  claude:node|pi:node) node_matches_agent_kind && live_agent=1 ;;
esac
is_live_agent() {
  [ -n "$live_agent" ]
}

ind_activity=""
ind_pr_state=""
capture_ind_marker() {
  local title="${1:-}" values
  case "$title" in
    *"[nmb-ind="*"]"*) ;;
    *) return 0 ;;
  esac
  values="${title##*\[nmb-ind=}"
  values="${values%%]*}"
  ind_activity="${values%%,*}"
  ind_pr_state="${values#*,}"
}
if is_remote_candidate_command "$effective_command"; then
  capture_ind_marker "$pane_title"
  [ -n "$ind_activity$ind_pr_state" ] || capture_ind_marker "$window_name"
fi

cached_window_label=""
label=""
non_agent_fallback=""
if is_live_agent; then
  cached_window_label="$(tmux show-options -qv -p -t "$pane_id" "@window-label" 2>/dev/null || true)"
  task_state="$(tmux show-options -qv -p -t "$pane_id" "@task_state" 2>/dev/null || true)"
  task_source="$(tmux show-options -qv -p -t "$pane_id" "@task_source" 2>/dev/null || true)"
  task_label="$(tmux show-options -qv -p -t "$pane_id" "@task_label" 2>/dev/null || true)"
  if [ -n "$task_state" ] && [ -n "$task_source" ] && [ -n "$task_label" ]; then
    label="$cached_window_label"
  else
    cached_window_label=""
  fi
fi
task_label_resolved=""

task_from_remote_label() {
  [ -x "$task_label_helper" ] || return 1
  "$task_label_helper" extract-remote "${1:-}"
}

render_remote_label() {
  [ -x "$task_label_helper" ] || return 1
  "$task_label_helper" render-remote "${1:-}"
}

remote_host_suffix() {
  printf '%s\n' "${1##* | }"
}

strip_host_suffix() {
  printf '%s\n' "${1%% | *}"
}

sanitize_window_name() {
  local value="${1:-}"
  value="${value//./-}"
  value="$(printf '%s\n' "$value" | sed -E 's/[[:space:]]*:[[:space:]]*/ - /g')"
  while [[ "$value" == *" -  - "* ]]; do
    value="${value// -  - / - - }"
  done
  printf '%s\n' "$value"
}

truncate_window_name() {
  local value="${1:-}" truncated
  if [ -x "$task_label_helper" ] && truncated="$("$task_label_helper" truncate "$value" 2>/dev/null)"; then
    printf '%s\n' "$truncated"
  else
    printf '%s\n' "$value"
  fi
}

if [ -z "$label" ] && is_remote_candidate_command "$effective_command"; then
  label="$(task_from_remote_label "$pane_title" 2>/dev/null || true)"
  if [ -n "$label" ]; then
    task_label_resolved="1"
  else
    rendered_window="$(render_remote_label "$window_name" 2>/dev/null || true)"
    if [ -n "$rendered_window" ] && [ "$pane_title" = "$(remote_host_suffix "$rendered_window")" ]; then
      label="$(task_from_remote_label "$window_name" 2>/dev/null || true)"
      [ -z "$label" ] || task_label_resolved="1"
    fi
  fi
  if [ -z "$label" ]; then
    structured_marker="$(tmux show-options -qv -p -t "$pane_id" "@pane-title-structured" 2>/dev/null || true)"
    cached_pane_label="$(tmux show-options -qv -p -t "$pane_id" "@pane-label" 2>/dev/null || true)"
    if [ -n "$structured_marker" ] && [[ "$cached_pane_label" == *" | "* ]]; then
      label="$(task_from_remote_label "$cached_pane_label" 2>/dev/null || true)"
      if [ -n "$label" ]; then
        task_label_resolved="1"
      else
        label="$cached_pane_label"
      fi
    fi
  fi
fi

if [ -z "$label" ] && is_live_agent; then
  agent_path="$(tmux show-options -qv -p -t "$pane_id" "@agent_worktree_path" 2>/dev/null || true)"
  if [ -n "$agent_path" ]; then
    label="$(tmux show-options -qv -p -t "$pane_id" "@pane-label" 2>/dev/null || true)"
  fi
fi

if [ -z "$label" ]; then
  if is_live_agent; then
    label_helper="${TMUX_PANE_LABEL_BIN:-$HOME/.local/bin/tmux-pane-label}"
    if [ ! -x "$label_helper" ]; then
      label_helper="tmux-pane-label"
    fi

    label="$("$label_helper" "$pane_tty" "$pane_current_path" "$effective_command" "$pane_id" 2>/dev/null || true)"
  elif [ -n "$pane_current_path" ]; then
    directory_path="$(git -C "$pane_current_path" rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "$directory_path" ] || directory_path="$pane_current_path"
    directory="$(basename "$directory_path")"
    label="$effective_command | $directory"
    non_agent_fallback="1"
  fi
fi
if [ -z "$cached_window_label" ] && [ -z "$task_label_resolved" ] && [ -z "$non_agent_fallback" ]; then
  label="$(strip_host_suffix "$label")"
fi
label="$(sanitize_window_name "$label")"
label="$(truncate_window_name "$label")"
[ -n "$label" ] || exit 0

activity=""
pr_state=""
if is_live_agent; then
  activity="$(tmux show-options -qv -p -t "$pane_id" "@agent_activity" 2>/dev/null || true)"
  pr_state="$(tmux show-options -qv -p -t "$pane_id" "@pr_state" 2>/dev/null || true)"
fi
if [ -z "$activity" ] && [ -z "$pr_state" ]; then
  activity="$ind_activity"
  pr_state="$ind_pr_state"
fi
glyphs=""
if { [ -n "$activity" ] || [ -n "$pr_state" ]; } && [ -x "$glyphs_helper" ]; then
  glyphs="$("$glyphs_helper" "$activity" "$pr_state" 2>/dev/null || true)"
fi
mutation_status=0
if [ -n "$glyphs" ]; then
  tmux set-option -wq -t "$window_id" @window-indicators "$glyphs" 2>/dev/null || mutation_status=1
else
  tmux set-option -wqu -t "$window_id" @window-indicators 2>/dev/null || mutation_status=1
fi

if [ "$label" != "$window_name" ]; then
  tmux rename-window -t "$window_id" "$label" 2>/dev/null || mutation_status=1
fi
exit "$mutation_status"
