#!/usr/bin/env bash
# Remove per-Node/global-prefix Pi installs that can shadow the mise-managed npm
# tool. Both the pre-rename @mariozechner package and per-Node installs of the
# current @earendil-works package are stale under the managed npm-tool policy.
#
# Only the explicit global-prefix globs below are scanned. The separate mise npm
# tool install root is not included.
#
# Idempotent: prints "changed" if it removed anything, "unchanged" otherwise, so
# a provisioning caller can map the exit output to a changed state.
set -euo pipefail

stale_packages="@mariozechner/pi-coding-agent @earendil-works/pi-coding-agent"

# Space-separated glob patterns of Node "prefix" dirs. Each prefix is expected
# to hold lib/node_modules/<pkg> and bin/pi (the layout npm -g and Homebrew's
# node both use). Overridable so the test can point at a scratch tree.
default_globs="${HOME}/.local/share/mise/installs/node/* /opt/homebrew /usr/local"
prefix_globs="${PI_LEGACY_PREFIX_GLOBS:-$default_globs}"

changed=0

# shellcheck disable=SC2086 # intentional word-splitting of the glob list
for prefix in $prefix_globs; do
  [ -d "$prefix" ] || continue

  for stale_pkg in $stale_packages; do
    pkg_dir="$prefix/lib/node_modules/$stale_pkg"
    if [ -e "$pkg_dir" ] || [ -L "$pkg_dir" ]; then
      rm -rf "$pkg_dir"
      changed=1

      # Drop the scope dir only when nothing else lives under it.
      scope="${stale_pkg%%/*}"
      scope_dir="$prefix/lib/node_modules/$scope"
      if [ -d "$scope_dir" ] && [ -z "$(ls -A "$scope_dir")" ]; then
        rmdir "$scope_dir"
      fi
    fi
  done

  # Remove bin/pi only when its target points into one of the stale package
  # identities. Unrelated pi links remain untouched.
  pi_bin="$prefix/bin/pi"
  if [ -L "$pi_bin" ]; then
    case "$(readlink "$pi_bin")" in
      */@mariozechner/pi-coding-agent/*|@mariozechner/pi-coding-agent/*|*/@earendil-works/pi-coding-agent/*|@earendil-works/pi-coding-agent/*)
        rm -f "$pi_bin"
        changed=1
        ;;
    esac
  fi
done

if [ "$changed" -eq 1 ]; then
  echo changed
else
  echo unchanged
fi
