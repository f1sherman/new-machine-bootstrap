#!/usr/bin/env bash
set -euo pipefail

# Skip when something else is managing the status/border bars (e.g. a
# system-level /etc/tmux.conf). Opt out with: tmux set -g @managed-bars off
if [ "$(tmux show -gv @managed-bars 2>/dev/null)" = "off" ]; then
  exit 0
fi

pane_id="${1:-${TMUX_PANE:-}}"
[ -n "$pane_id" ] || exit 0

target="$(tmux display-message -p -t "$pane_id" '#{session_id} #{window_id}' 2>/dev/null || true)"
session_id="${target%% *}"
window_id="${target#* }"
[ -n "$session_id" ] && [ -n "$window_id" ] && [ "$session_id" != "$window_id" ] || exit 0

nested_client_only="$(
  tmux show-options -v -t "$session_id" @nested-client-only 2>/dev/null || true
)"
pane_border_status=bottom
[ "$nested_client_only" = "1" ] && pane_border_status=off

tmux set-window-option -q -t "$window_id" pane-border-status "$pane_border_status" 2>/dev/null || true
exit 0
