#!/usr/bin/env bash
set -euo pipefail

pane_id="${1:-${TMUX_PANE:-}}"
request_id="${2:-}"
effective_command="${3:-zsh}"
suppress_edge="${4:-0}"
[ -n "$pane_id" ] || exit 0
[ -n "$request_id" ] || exit 0
case "$request_id" in
  *[!A-Za-z0-9._-]*) exit 0 ;;
esac

user_id="${UID:-$(id -u)}"
if [ -n "${TMUX_TITLE_TRANSITION_STATE_DIR:-}" ]; then
  state_root="$TMUX_TITLE_TRANSITION_STATE_DIR"
elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  state_root="${XDG_RUNTIME_DIR%/}/tmux-title-transition"
elif [ -n "${TMPDIR:-}" ]; then
  state_root="${TMPDIR%/}/tmux-title-transition-$user_id"
elif [ -n "${HOME:-}" ]; then
  state_root="${HOME%/}/.local/state/tmux-title-transition"
else
  state_root="/tmp/tmux-title-transition-$user_id"
fi
tmux_value="${TMUX:-}"
tmux_socket="${tmux_value%%,*}"
if [ -n "$tmux_socket" ]; then
  read -r socket_checksum socket_bytes _ <<< "$(printf '%s' "$tmux_socket" | cksum)"
  tmux_server="socket-$socket_checksum-$socket_bytes"
else
  tmux_server="default"
fi
pane_key="$(printf '%s.%s' "$tmux_server" "$pane_id" | tr -c 'A-Za-z0-9._-' '_')"
state_dir="$state_root/$pane_key"
requests_dir="$state_dir/requests"
lock_dir="$state_dir/worker.lock"
lock_owner_file="$lock_dir/owner"
lock_owner_tmp="$lock_dir/owner.tmp.$$"
lock_owner_metadata="$$"$'\t'"$request_id"
completed_file="$state_dir/completed"
request_file="$requests_dir/$request_id"
lock_held=0

mkdir -p "$requests_dir" 2>/dev/null || exit 0
chmod 700 "$state_root" "$state_dir" "$requests_dir" 2>/dev/null || true
: > "$request_file" || exit 0

lock_owner_snapshot() {
  cat "$lock_owner_file" 2>/dev/null
}

cleanup() {
  local owner="" released_owner="$state_dir/worker.lock.owner.released.$$"
  rm -f "$request_file" "$lock_owner_tmp" 2>/dev/null || true
  if [ "$lock_held" = "1" ] && owner="$(lock_owner_snapshot)"; then
    if [ "$owner" = "$lock_owner_metadata" ] && mv "$lock_owner_file" "$released_owner" 2>/dev/null; then
      rmdir "$lock_dir" 2>/dev/null || true
      rm -f "$released_owner" 2>/dev/null || true
    fi
  fi
}

terminate() {
  trap - EXIT HUP INT TERM
  cleanup
  exit 0
}

trap cleanup EXIT
trap terminate HUP INT TERM

latest_request() {
  local path candidate latest=""
  for path in "$requests_dir"/*; do
    [ -f "$path" ] || continue
    candidate="${path##*/}"
    if [ -z "$latest" ] || [[ "$candidate" > "$latest" ]]; then
      latest="$candidate"
    fi
  done
  printf '%s\n' "$latest"
}

is_stale() {
  local completed="" latest=""
  if [ -f "$completed_file" ]; then
    IFS= read -r completed < "$completed_file" || true
  fi
  latest="$(latest_request)"
  { [ -n "$completed" ] && [[ "$request_id" < "$completed" ]]; } ||
    { [ -n "$latest" ] && [[ "$request_id" < "$latest" ]]; }
}

process_matches_owner() {
  local owner_pid="$1" owner_request="$2" args="" token ps_bin="${TMUX_TITLE_TRANSITION_PS_BIN:-ps}"
  [[ "$owner_pid" =~ ^[1-9][0-9]*$ ]] || return 1
  [ -n "$owner_request" ] || return 1
  kill -0 "$owner_pid" 2>/dev/null || return 1
  args="$(command "$ps_bin" -p "$owner_pid" -o args= 2>/dev/null)" || return 1
  for token in $args; do
    [ "$token" = "$owner_request" ] && return 0
  done
  return 1
}

recover_abandoned_lock() {
  local owner="" owner_pid="" owner_request="" owner_extra="" confirmed_owner=""
  local abandoned_owner="$state_dir/worker.lock.owner.abandoned.$$"

  if [ ! -f "$lock_owner_file" ]; then
    sleep 0.05
    if [ ! -f "$lock_owner_file" ]; then
      rmdir "$lock_dir" 2>/dev/null || true
      return
    fi
  fi

  owner="$(lock_owner_snapshot)" || return 0
  IFS=$'\t' read -r owner_pid owner_request owner_extra <<< "$owner"
  if [ -z "$owner_extra" ] && process_matches_owner "$owner_pid" "$owner_request"; then
    return
  fi

  confirmed_owner="$(lock_owner_snapshot)" || return 0
  [ "$confirmed_owner" = "$owner" ] || return 0
  rm -f "$abandoned_owner" 2>/dev/null || true
  if mv "$lock_owner_file" "$abandoned_owner" 2>/dev/null; then
    if ! rmdir "$lock_dir" 2>/dev/null; then
      [ -e "$lock_owner_file" ] || mv "$abandoned_owner" "$lock_owner_file" 2>/dev/null || true
    fi
    rm -f "$abandoned_owner" 2>/dev/null || true
  fi
}

while ! mkdir "$lock_dir" 2>/dev/null; do
  if is_stale; then
    exit 0
  fi
  recover_abandoned_lock
  sleep 0.01
done
chmod 700 "$lock_dir" 2>/dev/null || true
if ! printf '%s\n' "$lock_owner_metadata" > "$lock_owner_tmp" ||
   ! mv -f "$lock_owner_tmp" "$lock_owner_file"; then
  rm -f "$lock_owner_tmp" 2>/dev/null || true
  rmdir "$lock_dir" 2>/dev/null || true
  exit 0
fi
lock_held=1

if is_stale; then
  exit 0
fi

if [ "$effective_command" = "zsh" ]; then
  agent_state_helper="${TMUX_TITLE_TRANSITION_AGENT_STATE_BIN:-tmux-agent-state}"
  if command -v "$agent_state_helper" >/dev/null 2>&1; then
    TMUX_PANE="$pane_id" command "$agent_state_helper" clear-provisional >/dev/null 2>&1 || true
  fi
fi

title_helper="${TMUX_TITLE_TRANSITION_WINDOW_LABEL_BIN:-tmux-window-label}"
remote_helper="${TMUX_TITLE_TRANSITION_REMOTE_TITLE_BIN:-tmux-remote-title}"
render_succeeded=0
if command "$title_helper" "$pane_id" "${effective_command:-zsh}" >/dev/null 2>&1; then
  render_succeeded=1
fi

if [ "$render_succeeded" = "1" ] && ! is_stale && [ -n "${SSH_CONNECTION:-}${CODESPACES:-}${DEVPOD_WORKSPACE_ID:-}" ] && command -v "$remote_helper" >/dev/null 2>&1; then
  if [ "$suppress_edge" = "1" ]; then
    TMUX_REMOTE_TITLE_SUPPRESS_EDGE=1 command "$remote_helper" publish >/dev/null 2>&1 || true
  else
    command "$remote_helper" publish >/dev/null 2>&1 || true
  fi
fi

completed=""
if [ -f "$completed_file" ]; then
  IFS= read -r completed < "$completed_file" || true
fi
if [ -z "$completed" ] || [[ "$completed" < "$request_id" ]]; then
  completed_tmp="$state_dir/completed.$$"
  printf '%s\n' "$request_id" > "$completed_tmp"
  mv -f "$completed_tmp" "$completed_file"
fi
