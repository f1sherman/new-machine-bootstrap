<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.development-cache-cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{ ansible_facts["user_dir"] }}/.local/bin/development-cache-cleanup</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>{{ ansible_facts["user_dir"] }}</string>
        <key>PATH</key>
        <string>{{ ansible_facts["user_dir"] }}/.local/share/mise/shims:{{ ansible_facts["user_dir"] }}/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>LowPriorityIO</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>{{ ansible_facts["user_dir"] }}/Library/Logs/development-cache-cleanup.err</string>
    <key>StandardOutPath</key>
    <string>{{ ansible_facts["user_dir"] }}/Library/Logs/development-cache-cleanup.log</string>
</dict>
</plist>
