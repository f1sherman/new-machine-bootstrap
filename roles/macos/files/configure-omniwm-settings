class SettingsDocument
  Block = Struct.new(:type, :lines, keyword_init: true)
  REPEATED_HEADER = /^\s*\[\[([A-Za-z0-9_.-]+)\]\]\s*(?:#.*)?$/
  TABLE_HEADER = /^\s*\[([A-Za-z0-9_.-]+)\]\s*(?:#.*)?$/
  RULE_SELECTOR_KEYS = %w[
    appNameSubstring axRole axSubrole bundleId id titleRegex titleSubstring
  ].freeze

  attr_reader :blocks

  def self.parse(text)
    blocks = [Block.new(type: nil, lines: [])]
    text.lines.each do |line|
      stripped = line.lstrip
      if (match = line.match(REPEATED_HEADER))
        blocks << Block.new(type: match[1], lines: [line])
      elsif stripped.start_with?("[")
        raise "invalid table header: #{line.strip}" unless line.match?(TABLE_HEADER)

        blocks.last.lines << line
      else
        validate_scalar_line!(line)
        blocks.last.lines << line
      end
    end

    document = new(blocks)
    document.validate!
    document
  end

  def self.validate_scalar_line!(line)
    content = without_comment(line).strip
    return if content.empty?

    match = content.match(/\A[A-Za-z0-9_.-]+\s*=\s*(.+)\z/)
    raise "invalid scalar assignment: #{content}" unless match
    raise "invalid scalar value: #{content}" unless valid_value?(match[1].strip)
  end

  def self.without_comment(line)
    quoted = false
    escaped = false
    result = +""

    line.each_char do |character|
      break if character == "#" && !quoted

      result << character
      if escaped
        escaped = false
      elsif character == "\\" && quoted
        escaped = true
      elsif character == '"'
        quoted = !quoted
      end
    end

    raise "unterminated quoted value" if quoted

    result
  end

  def self.valid_value?(value)
    return valid_basic_string?(value) if value.start_with?('"')
    return true if %w[true false].include?(value)
    return true if value.match?(/\A[+-]?(?:0|[1-9](?:_?\d)*)(?:\.\d(?:_?\d)*)?(?:[eE][+-]?\d(?:_?\d)*)?\z/)
    return valid_array?(value) if value.start_with?("[")

    false
  end

  def self.valid_basic_string?(value)
    return false unless value.end_with?('"')

    characters = value[1...-1].chars
    index = 0
    while index < characters.length
      character = characters[index]
      return false if character.ord < 0x20

      unless character == "\\"
        return false if character == '"'

        index += 1
        next
      end

      escape = characters[index + 1]
      return false unless escape

      if %w[" \\ b t n f r].include?(escape)
        index += 2
        next
      end

      digits = escape == "u" ? 4 : escape == "U" ? 8 : nil
      return false unless digits

      codepoint = characters[(index + 2), digits]
      return false unless codepoint&.length == digits && codepoint.join.match?(/\A[0-9A-Fa-f]+\z/)

      index += digits + 2
    end

    true
  end

  def self.valid_array?(value)
    return false unless value.end_with?("]")

    body = value[1...-1].strip
    return true if body.empty?

    body.split(",", -1).all? do |element|
      scalar = element.strip
      !scalar.empty? && valid_value?(scalar)
    end
  end

  def initialize(blocks)
    @blocks = blocks
  end

  def validate!
    preamble = blocks.first.lines.join
    raise "missing [general] table" unless preamble.match?(/^\s*\[general\]\s*$/)
    raise "missing hotkey block" unless blocks.any? { |block| block.type == "hotkeys" }
    raise "missing workspace block" unless blocks.any? { |block| block.type == "workspaces" }
  end

  def reconcile!(activate_assignments: false)
    reconcile_workspace_bar
    reconcile_hotkeys
    reconcile_rules(activate_assignments)
    reconcile_workspaces
    self
  end

  def to_s
    blocks.flat_map(&:lines).join
  end

  private

  def scalar_value(block, key)
    scalar_lines(block).each do |line|
      match = line.match(/^\s*#{Regexp.escape(key)}\s*=\s*"((?:\\.|[^"])*)"\s*(?:#.*)?$/)
      return match[1] if match
    end
    nil
  end

  def scalar_lines(block)
    block.lines.drop(1).take_while { |line| !line.match?(TABLE_HEADER) }
  end

  def set_scalar(block, key, value)
    scalar_end = block.lines.index.with_index do |line, index|
      index.positive? && line.match?(TABLE_HEADER)
    end || block.lines.length
    existing = (1...scalar_end).find do |index|
      block.lines[index].match?(/^\s*#{Regexp.escape(key)}\s*=/)
    end

    if existing
      block.lines[existing] = %(#{key} = "#{value}"\n)
      return
    end

    insertion = scalar_end
    insertion -= 1 while insertion > 1 && block.lines[insertion - 1].strip.empty?
    block.lines.insert(insertion, %(#{key} = "#{value}"\n))
  end

  def remove_scalar(block, key)
    scalar_end = block.lines.index.with_index do |line, index|
      index.positive? && line.match?(TABLE_HEADER)
    end || block.lines.length
    block.lines = block.lines.each_with_index.reject do |line, index|
      index.between?(1, scalar_end - 1) && line.match?(/^\s*#{Regexp.escape(key)}\s*=/)
    end.map(&:first)
  end

  def set_table_scalar(block, table, key, value, quoted: true)
    rendered_value = quoted ? %("#{value}") : value.to_s
    header = block.lines.index do |line|
      match = line.match(TABLE_HEADER)
      match && match[1] == table
    end
    unless header
      block.lines << "\n" unless block.lines.last&.strip&.empty?
      block.lines << "[#{table}]\n"
      block.lines << %(#{key} = #{rendered_value}\n)
      return
    end

    table_end = ((header + 1)...block.lines.length).find do |index|
      block.lines[index].match?(TABLE_HEADER)
    end || block.lines.length
    existing = ((header + 1)...table_end).find do |index|
      block.lines[index].match?(/^\s*#{Regexp.escape(key)}\s*=/)
    end
    if existing
      block.lines[existing] = %(#{key} = #{rendered_value}\n)
      return
    end

    insertion = table_end
    insertion -= 1 while insertion > header + 1 && block.lines[insertion - 1].strip.empty?
    block.lines.insert(insertion, %(#{key} = #{rendered_value}\n))
  end

  def reconcile_workspace_bar
    preamble = blocks.first
    set_table_scalar(preamble, "workspaceBar", "enabled", true, quoted: false)
    set_table_scalar(preamble, "workspaceBar", "position", "belowMenuBar")
    set_table_scalar(preamble, "workspaceBar", "reserveLayoutSpace", true, quoted: false)
    set_table_scalar(preamble, "workspaceBar", "revealModifier", "off")
  end

  def reconcile_hotkeys
    directional_bindings = {
      "focus.left" => "Control+Option+Left Arrow",
      "focus.right" => "Control+Option+Right Arrow",
      "focus.up" => "Control+Option+Up Arrow",
      "focus.down" => "Control+Option+Down Arrow",
      "move.left" => "Control+Option+Shift+Left Arrow",
      "move.right" => "Control+Option+Shift+Right Arrow",
      "move.up" => "Control+Option+Shift+Up Arrow",
      "move.down" => "Control+Option+Shift+Down Arrow"
    }
    reserved_bindings = directional_bindings.values

    blocks.select { |block| block.type == "hotkeys" }.each do |block|
      identifier = scalar_value(block, "id")
      binding = scalar_value(block, "binding")
      desired_binding = directional_bindings[identifier]
      if desired_binding
        set_scalar(block, "binding", desired_binding)
        next
      end

      option_arrow = binding&.match?(/^Option\+(?:Shift\+)?(?:Left|Right|Up|Down) Arrow$/)
      reserved_binding = reserved_bindings.include?(binding)
      next unless option_arrow || reserved_binding || identifier == "toggleScratchpadWindow"

      set_scalar(block, "binding", "Unassigned")
    end
  end

  def reconcile_rules(activate_assignments)
    RULE_TARGETS.each do |target|
      matches = matching_rule_blocks(target)
      unless activate_assignments
        matches.each { |block| remove_scalar(block, "assignToWorkspace") }
        next
      end

      if matches.empty?
        insert_rule(target)
      else
        set_scalar(matches.first, "assignToWorkspace", target.workspace)
        matches.drop(1).each { |block| remove_scalar(block, "assignToWorkspace") }
      end
    end

    DYNAMIC_RULE_TARGETS.each do |target|
      matching_rule_blocks(target).each do |block|
        remove_scalar(block, "assignToWorkspace")
        blocks.delete(block) if effectless_rule?(block)
      end
    end
  end

  def effectless_rule?(block)
    return false if block.lines.drop(1).any? { |line| line.match?(TABLE_HEADER) }

    keys = block.lines.drop(1).filter_map do |line|
      line[/^\s*([A-Za-z][A-Za-z0-9]*)\s*=/, 1]
    end
    (keys - RULE_SELECTOR_KEYS).empty?
  end

  def matching_rule_blocks(target)
    blocks.select do |block|
      next false unless block.type == "appRules"
      next false unless scalar_value(block, "bundleId") == target.bundle_id
      next false unless scalar_value(block, "titleSubstring") == target.title_substring

      selectors = scalar_lines(block).filter_map do |line|
        key = line[/^\s*([A-Za-z][A-Za-z0-9]*)\s*=/, 1]
        key if RULE_SELECTOR_KEYS.include?(key)
      end
      allowed_selectors = %w[bundleId id]
      allowed_selectors << "titleSubstring" if target.title_substring
      (selectors - allowed_selectors).empty?
    end
  end

  def insert_rule(target)
    lines = ["[[appRules]]\n", %(bundleId = "#{target.bundle_id}"\n)]
    lines << %(titleSubstring = "#{target.title_substring}"\n) if target.title_substring
    lines << %(id = "#{SecureRandom.uuid.upcase}"\n)
    lines << %(assignToWorkspace = "#{target.workspace}"\n)
    lines << "\n"
    block = Block.new(type: "appRules", lines: lines)

    last_rule = blocks.rindex { |candidate| candidate.type == "appRules" }
    insertion = last_rule ? last_rule + 1 : blocks.index { |candidate| candidate.type == "hotkeys" }
    insertion ||= blocks.length
    ensure_block_separator(insertion)
    blocks.insert(insertion, block)
  end

  def reconcile_workspaces
    workspace_blocks = blocks.select { |block| block.type == "workspaces" }
    workspace_blocks.each { |block| remove_scalar(block, "displayName") }

    MANAGED_WORKSPACES.each do |workspace|
      existing = workspace_blocks.find { |block| scalar_value(block, "name") == workspace.name }
      if existing
        set_scalar(existing, "layoutType", workspace.layout_type)
        set_table_scalar(existing, "workspaces.monitorAssignment", "type", workspace.monitor)
        next
      end

      ensure_block_separator(blocks.length)
      block = Block.new(type: "workspaces", lines: [
        "[[workspaces]]\n",
        %(id = "#{workspace.id}"\n),
        %(name = "#{workspace.name}"\n),
        %(layoutType = "#{workspace.layout_type}"\n),
        "\n",
        "[workspaces.monitorAssignment]\n",
        %(type = "#{workspace.monitor}"\n),
        "\n"
      ])
      blocks << block
      workspace_blocks << block
    end
  end

  def ensure_block_separator(insertion)
    return if insertion.zero?

    previous = blocks[insertion - 1]
    last_line = previous.lines.last
    previous.lines[-1] = "#{last_line}\n" if last_line && !last_line.end_with?("\n")
    previous.lines << "\n" unless previous.lines.last&.strip&.empty?
  end
end

class SettingsWriter
  def self.replace(path, contents)
    directory = File.dirname(path)
    basename = File.basename(path)
    temporary = Tempfile.new([".#{basename}", ".tmp"], directory)
    temporary.binmode
    temporary.chmod(0o600)
    temporary.write(contents)
    temporary.flush
    temporary.fsync
    temporary.close
    File.rename(temporary.path, path)
  ensure
    temporary&.close unless temporary&.closed?
    temporary&.unlink if temporary && File.exist?(temporary.path)
  end
end

def main
  path_argument, *options = ARGV
  valid_options = %w[--activate-assignments --check]
  valid_arguments = !path_argument.nil? &&
    options.uniq.length == options.length &&
    (options - valid_options).empty?
  usage = "usage: configure-omniwm-settings SETTINGS_PATH [--activate-assignments] [--check]"
  raise usage unless valid_arguments

  path = File.expand_path(path_argument)
  original = File.binread(path).force_encoding(Encoding::UTF_8)
  raise "settings file is not valid UTF-8" unless original.valid_encoding?

  document = SettingsDocument.parse(original)
  result = document.reconcile!(activate_assignments: options.include?("--activate-assignments")).to_s
  SettingsDocument.parse(result)

  if result == original
    puts "unchanged"
  else
    SettingsWriter.replace(path, result) unless options.include?("--check")
    puts "changed"
  end
rescue => error
  warn "configure-omniwm-settings: #{error.message}"
  exit 1
end

main if $PROGRAM_NAME == __FILE__
