#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

root="$(cd "$(dirname "$0")/.." && pwd)"
fragments="$root/roles/common/files/pi/base-fragments"
output="$root/roles/common/files/pi/AGENTS.md.d/00-base.md"
shopt -s nullglob
files=("$fragments"/*.md)
if (( ${#files[@]} == 0 )); then
  echo 'No Pi guidance fragments found' >&2
  exit 1
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
for file in "${files[@]}"; do
  content="$(<"$file")"
  case "$file" in
    *.space.md) printf '%s ' "$content" ;;
    *.blank.md) printf '%s\n\n' "$content" ;;
    *) printf '%s\n' "$content" ;;
  esac
done > "$tmp"
case "${1:-}" in
  '')
    [[ $# -eq 0 ]] || exit 1
    cp "$tmp" "$output"
    ;;
  --check)
    [[ $# -eq 1 ]] || exit 1
    cmp -s "$tmp" "$output" || {
      echo 'Pi base guidance is out of date; run bin/assemble-pi-base' >&2
      exit 1
    }
    ;;
  *)
    echo 'Usage: bin/assemble-pi-base [--check]' >&2
    exit 1
    ;;
esac
