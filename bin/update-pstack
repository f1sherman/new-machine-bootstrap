#!/usr/bin/env python3
"""Regenerate the official pstack snapshot at the repository's pinned commit."""

import argparse
import fcntl
import hashlib
import io
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile

REPOSITORY = "https://github.com/cursor/plugins.git"
VENDOR = Path("roles/common/files/vendor/pstack")
SELECTED = {"skills", "agents", "docs", "README.md", "LICENSE"}
REQUIRED = {
    "LICENSE", "README.md", "agents/poteto-agent.md",
    "docs/harness/claude-code.md", "skills/how/SKILL.md",
    "external/LICENSE", "external/deslop/SKILL.md",
    "skills/poteto-mode/SKILL.md", "skills/poteto-help/SKILL.md",
}


def git(root, *args):
    return subprocess.check_output(
        ["git", "-C", str(root), *args], stderr=subprocess.PIPE
    )


def pinned_commit(root):
    text = (root / "vars/tool_versions.yml").read_text()
    in_section = False
    matches = []
    sections = 0
    for line in text.splitlines():
        if line == "  git_commits:":
            in_section = True
            sections += 1
        elif re.match(r"^  \S", line):
            in_section = False
        elif in_section:
            match = re.fullmatch(r"    pstack: ([0-9a-f]{40})", line)
            if match:
                matches.append(match[1])
    if sections != 1 or len(matches) != 1:
        raise ValueError("Expected one full pstack SHA in tool_versions.git_commits")
    return matches[0]


def snapshot(root):
    result = {}
    if not root.exists():
        return result
    for file in sorted(root.rglob("*")):
        if file.is_symlink():
            raise ValueError(f"Expected regular snapshot entry: {file}")
        if file.is_file():
            result[file.relative_to(root).as_posix()] = (
                hashlib.sha256(file.read_bytes()).hexdigest(), file.stat().st_mode & 0o111
            )
        elif not file.is_dir():
            raise ValueError(f"Expected regular snapshot entry: {file}")
    return result


def generate(checkout, commit, stage):
    # The empty worktree ignores committed export-ignore/export-subst attributes.
    archive = git(checkout, "-c", "core.attributesFile=/dev/null", "archive",
                  "--worktree-attributes", commit, "pstack", "cursor-team-kit")
    copied = set()
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as source:
        for entry in source:
            parts = PurePosixPath(entry.name).parts
            if not parts or parts[0] not in {"pstack", "cursor-team-kit"}:
                raise ValueError(f"Unexpected archive path: {entry.name}")
            if parts[0] == "pstack":
                if len(parts) < 2 or parts[1] not in SELECTED:
                    continue
                relative = PurePosixPath(*parts[1:])
            elif parts[1:] == ("LICENSE",):
                relative = PurePosixPath("external/LICENSE")
            elif parts[1:3] == ("skills", "deslop"):
                relative = PurePosixPath("external", *parts[2:])
            else:
                continue
            if ".." in parts or entry.name.startswith("/"):
                raise ValueError(f"Unsafe archive path: {entry.name}")
            if entry.isdir():
                continue
            if not entry.isfile():
                raise ValueError(f"Expected regular upstream file: {entry.name}")
            destination = stage / str(relative)
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(source.extractfile(entry).read())
            destination.chmod(0o755 if entry.mode & 0o111 else 0o644)
            copied.add(relative.as_posix())
    if REQUIRED - copied:
        raise ValueError(f"Required upstream files missing: {sorted(REQUIRED - copied)}")
    checksums = "".join(
        f"{hashlib.sha256((stage / name).read_bytes()).hexdigest()}  {name}\n"
        for name in sorted(copied)
    )
    (stage / "SHA256SUMS").write_text(checksums)
    (stage / "UPSTREAM.md").write_text(
        "# Official pstack reference snapshot\n\n"
        f"- Source: https://github.com/cursor/plugins/tree/{commit}/pstack\n"
        f"- Cleanup dependency: https://github.com/cursor/plugins/tree/{commit}/cursor-team-kit/skills/deslop\n"
        f"- Commit: `{commit}` (both packages).\n"
        "- Branch tracked by Renovate: `main`.\n"
        "- License: MIT, preserved in `LICENSE`.\n"
        "- Selected complete pstack paths: `skills/`, `agents/`, `docs/`, `README.md`, `LICENSE`.\n"
        "- Selected cursor-team-kit paths: `skills/deslop/` and `LICENSE`, mapped to `external/deslop/` and `external/LICENSE`.\n"
        "- Excluded: plugin registration, top-level assets, dormant automations, `.gitignore`.\n"
        "- Content modifications: none. Executable bits are preserved.\n"
        "- SHA256SUMS covers selected upstream files, not local provenance.\n\n"
        "Generated by `bin/update-pstack` from `tool_versions.git_commits.pstack`. "
        "Do not hand-edit this tree. Run `bin/update-pstack --check` to compare "
        "the complete tree and executable modes against the pinned Git source. "
        "Local portability policy lives in `roles/common/files/config/skills/pstack/pstack/`.\n"
    )


def validate_destination(root, destination):
    current = root
    for part in destination.relative_to(root).parts:
        current = current / part
        if current.is_symlink() or (current.exists() and not current.is_dir()):
            raise ValueError(f"Expected regular vendor directory: {current}")


def replace_snapshot(stage, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix=".pstack-backup-", dir=destination.parent))
    previous = backup / "snapshot"
    try:
        if destination.exists():
            destination.rename(previous)
        stage.rename(destination)
    except BaseException:
        if previous.exists():
            try:
                previous.rename(destination)
            except BaseException as error:
                raise OSError(f"Restore failed; previous snapshot backup retained at {previous}") from error
        backup.rmdir()
        raise
    shutil.rmtree(backup)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--source", default=REPOSITORY)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    root = args.repo_root.resolve()
    destination = root / VENDOR
    validate_destination(root, destination)
    cache = root / ".cache"
    if cache.is_symlink():
        raise ValueError("Expected regular cache directory")
    cache.mkdir(exist_ok=True)
    with (cache / "update-pstack.lock").open("a") as lock, \
            tempfile.TemporaryDirectory(prefix="pstack-", dir=cache) as temp:
        fcntl.flock(lock, fcntl.LOCK_EX)
        validate_destination(root, destination)
        backups = sorted(destination.parent.glob(".pstack-backup-*"))
        if backups:
            raise ValueError(f"Previous snapshot backup needs recovery: {backups}")
        commit = pinned_commit(root)
        temp = Path(temp)
        checkout, stage = temp / "source", temp / "generated"
        checkout.mkdir()
        stage.mkdir()
        git(checkout, "init", "--quiet")
        git(checkout, "remote", "add", "origin", args.source)
        git(checkout, "fetch", "--quiet", "--depth=1", "origin", commit)
        actual = git(checkout, "rev-parse", "FETCH_HEAD^{commit}").decode().strip()
        if actual != commit:
            raise ValueError(f"Fetched commit differs from pinned SHA: {actual}")
        generate(checkout, commit, stage)
        validate_destination(root, destination)
        if snapshot(destination) == snapshot(stage):
            print(f"pstack snapshot matches {commit}")
            return
        if args.check:
            raise ValueError("pstack snapshot differs from pinned source; run bin/update-pstack")
        replace_snapshot(stage, destination)
        print(f"Updated pstack snapshot to {commit}")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        detail = error.stderr.decode().strip() if isinstance(error, subprocess.CalledProcessError) else str(error)
        sys.exit(f"update-pstack: {detail}")
