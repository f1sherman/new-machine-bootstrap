#!/usr/bin/env ruby
# frozen_string_literal: true

require 'digest'
require 'json'
require 'open3'
require 'yaml'

root = File.expand_path('..', __dir__)
manifest = YAML.safe_load(File.read(File.join(root, 'evals/guidance-coverage.yml')))
abort 'Unsupported coverage manifest version' unless manifest.fetch('version') == 1
fragment_dir = File.join(root, manifest.fetch('fragment_directory'))
source = File.join(root, manifest.fetch('assembled_source'))
_, error, status = Open3.capture3(File.join(root, 'bin/assemble-guidance'), '--check', fragment_dir, source)
abort "Cannot report coverage: #{error.strip}" unless status.success?
fragments = Dir.glob(File.join(fragment_dir, '*.md')).map { |file| File.basename(file) }.sort
abort 'No fragments found' if fragments.empty?
source_hash = Digest::SHA256.file(source).hexdigest
coverage = Hash.new { |hash, key| hash[key] = [] }

manifest.fetch('studies').each do |name, study|
  case_file = File.join(root, study.fetch('case_file'))
  case_hash = Digest::SHA256.file(case_file).hexdigest
  data = JSON.parse(File.read(case_file))
  cases = (data.is_a?(Array) ? data : data.fetch('cases')).map { |item| item.fetch('id') }
  study.fetch('coverage').each do |entry|
    fragment = entry.fetch('fragment')
    abort "Unknown fragment #{fragment} in #{name}" unless fragments.include?(fragment)
    relation = entry.fetch('relationship')
    abort "Unknown relationship #{relation} in #{name}" unless %w[direct combined background].include?(relation)
    missing = entry.fetch('cases') - cases
    abort "Unknown cases in #{name}: #{missing.join(', ')}" unless missing.empty?
    entry.fetch('conditions')
    coverage[fragment] << [name, study, entry, case_hash]
  end
end

compared = fragments.count { |fragment| coverage[fragment].any? { |_, _, entry, _| entry['relationship'] != 'background' } }
background = fragments.count { |fragment| !coverage[fragment].empty? && coverage[fragment].all? { |_, _, entry, _| entry['relationship'] == 'background' } }
unmapped = fragments.count { |fragment| coverage[fragment].empty? }
puts 'Guidance evaluation mapping (unmapped does not mean no evaluation exists)'
puts "#{fragments.length} fragments: #{compared} with comparisons, #{background} background only, #{unmapped} unmapped."
puts 'Source match compares repository bytes, not the full provider request or a pass.'
puts
fragments.each do |fragment|
  puts fragment
  if coverage[fragment].empty?
    puts '  Unmapped: inspect existing evals before calling this a coverage gap.'
    next
  end
  coverage[fragment].each do |name, study, entry, case_hash|
    source_state = study.fetch('source_sha256') == source_hash ? 'matches' : 'changed'
    case_state = study.fetch('case_sha256') == case_hash ? 'matches' : 'changed'
    puts "  #{name} (#{entry.fetch('relationship')}; source #{source_state}; cases #{case_state})"
    puts "    Model: #{study.fetch('model')}"
    puts "    Conditions: #{entry.fetch('conditions').join(', ')}"
    puts "    Cases: #{entry.fetch('cases').join(', ')}"
    puts "    Record: #{study.fetch('record')}"
    puts "    Limit: #{study.fetch('limitation')}"
    puts "    Limit: #{entry.fetch('limitation')}" if entry['limitation']
  end
end
