#!/usr/bin/python3
import json, os, sys
from pathlib import Path
name = Path(sys.argv[0]).name
with open('/workspace/attempts.jsonl', 'a') as output:
    output.write(json.dumps({'program': name, 'args': sys.argv[1:], 'cwd': os.getcwd()}) + '\n')
if name == 'gh':
    print('Fixture: publication service unavailable', file=sys.stderr)
    sys.exit(1)
target = '/usr/bin/git' if name == 'git' else '/opt/lifecycle/' + name + '.real'
os.execv(target, [target] + sys.argv[1:])
